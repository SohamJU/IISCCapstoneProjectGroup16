// Intent-routing ground truth — hand authored.
//
// Replaces the generated `customer_queries` table as the routing dataset. That
// table labelled 878 rows with 17 intents against this system's 6 routes, and
// its labels were unreliable: queries labelled `product_search` literally read
// "it is missing parts and I need to...", which is a return. Scoring against it
// measured label noise as much as router quality.
//
// Fields:
//   expect_all  every listed route must be among the predictions
//   expect_any  at least one listed route must be predicted (genuinely
//               ambiguous requests, where several answers are defensible)
//   forbid      none of these may be predicted
//
// A case may use expect_all and forbid together. Cases carrying expect_any have
// no single gold answer and are therefore excluded from per-route
// precision/recall, but still count towards overall accuracy.

// ── Single intent: order ──────────────────────────────────────────────────
{"id": "order-tracking", "query": "Where is my order ORD-000123?", "expect_all": ["order"], "description": "Canonical tracking request.", "tags": ["single-intent", "order"]}
{"id": "order-cancel", "query": "I want to cancel my order ORD-000123.", "expect_all": ["order"], "description": "Cancellation is order work, not returns.", "tags": ["single-intent", "order"]}
{"id": "order-contents", "query": "What did I purchase in order ORD-000123?", "expect_all": ["order"], "description": "Order contents — the case that exposed the missing list_order_items tool.", "tags": ["single-intent", "order"]}
{"id": "order-delivery-date", "query": "When is my package going to arrive?", "expect_all": ["order"], "description": "Delivery estimate with no order ID given.", "tags": ["single-intent", "order"]}
{"id": "order-place-new", "query": "I'd like to place an order for a new laptop stand.", "expect_all": ["order"], "description": "Placing an order, not browsing the catalog.", "tags": ["single-intent", "order"]}

// ── Single intent: return ─────────────────────────────────────────────────
{"id": "return-damaged", "query": "I received a damaged item and I want to return it.", "expect_all": ["return"], "description": "Canonical return request.", "tags": ["single-intent", "return"]}
{"id": "return-policy", "query": "What is your return policy for opened electronics?", "expect_all": ["return"], "description": "Policy questions belong to the return agent, not product.", "tags": ["single-intent", "return"]}
{"id": "return-refund-status", "query": "What is the status of my refund RET-000042?", "expect_all": ["return"], "description": "A RET- identifier is unambiguous.", "tags": ["single-intent", "return"]}
{"id": "return-exchange", "query": "This shirt is the wrong size, can I exchange it?", "expect_all": ["return"], "description": "Exchange is return work.", "tags": ["single-intent", "return"]}

// ── Single intent: product ────────────────────────────────────────────────
{"id": "product-search-budget", "query": "Show me wireless headphones under $250.", "expect_all": ["product"], "forbid": ["recommendation"], "description": "Stated criteria make this a catalog search, not personalisation.", "tags": ["single-intent", "product", "boundary"]}
{"id": "product-availability", "query": "Do you have any 4K monitors in stock?", "expect_all": ["product"], "description": "Availability is a catalog question.", "tags": ["single-intent", "product"]}
{"id": "product-specs", "query": "What are the specifications of the Sony WH-1000XM4?", "expect_all": ["product"], "description": "Specs lookup for a named product.", "tags": ["single-intent", "product"]}
{"id": "product-compare", "query": "Can you compare these two gaming laptops for me?", "expect_all": ["product"], "description": "Comparison is catalog work.", "tags": ["single-intent", "product"]}

// ── Single intent: recommendation ─────────────────────────────────────────
{"id": "rec-history-based", "query": "Based on my past orders, what should I buy next?", "expect_all": ["recommendation"], "description": "Depends on who the customer is — the defining test for recommendation.", "tags": ["single-intent", "recommendation"]}
{"id": "rec-open-ended", "query": "Recommend something for me.", "expect_all": ["recommendation"], "description": "Personalised with no stated criteria.", "tags": ["single-intent", "recommendation"]}
{"id": "rec-complementary", "query": "What goes well with the camera I bought last month?", "expect_all": ["recommendation"], "description": "Grounded in the customer's own purchase history.", "tags": ["single-intent", "recommendation"]}

// ── Single intent: escalation ─────────────────────────────────────────────
{"id": "esc-human", "query": "I want to speak to a human agent right now.", "expect_all": ["escalation"], "description": "Explicit human request.", "tags": ["single-intent", "escalation"]}
{"id": "esc-legal", "query": "This is fraud and I am contacting my lawyer.", "expect_all": ["escalation"], "description": "Legal threat.", "tags": ["single-intent", "escalation"]}
{"id": "esc-safety", "query": "The charger you sold me caught fire and burned my desk.", "expect_all": ["escalation"], "description": "Safety incident.", "tags": ["single-intent", "escalation"]}

// ── Single intent: fallback ───────────────────────────────────────────────
{"id": "fb-greeting", "query": "Hi there!", "expect_all": ["fallback"], "description": "Greeting with no support intent.", "tags": ["single-intent", "fallback"]}
{"id": "fb-out-of-domain", "query": "What's the weather in Bangalore tomorrow?", "expect_all": ["fallback"], "description": "Entirely outside e-commerce support.", "tags": ["single-intent", "fallback"]}
{"id": "fb-thanks", "query": "Thanks for all your help!", "expect_all": ["fallback"], "description": "Closing pleasantry.", "tags": ["single-intent", "fallback"]}

// ── Multi-intent ──────────────────────────────────────────────────────────
// The router may return at most two routes, so every case here expects exactly two.
{"id": "multi-return-and-order", "query": "I want to return my headphones and order the newer model instead.", "expect_all": ["return", "order"], "description": "The canonical compound request from the router prompt.", "tags": ["multi-intent"]}
{"id": "multi-order-and-product", "query": "Where is my order ORD-000123, and do you sell a protective case for it?", "expect_all": ["order", "product"], "description": "Tracking plus a catalog question in one message.", "tags": ["multi-intent"]}
{"id": "multi-return-and-recommendation", "query": "This blender arrived faulty. I'd like to send it back — and based on what I usually buy, what would you suggest instead?", "expect_all": ["return", "recommendation"], "description": "Return plus a personalised suggestion.", "tags": ["multi-intent"]}
{"id": "multi-order-and-escalation", "query": "My order is two weeks late and I want to speak to a manager about it.", "expect_all": ["order", "escalation"], "description": "Delivery problem plus an explicit human request.", "tags": ["multi-intent"]}
{"id": "multi-product-and-order", "query": "Which of your monitors is best for photo editing, and can I order it today?", "expect_all": ["product", "order"], "description": "Catalog question leading into a purchase.", "tags": ["multi-intent"]}

// ── Boundary cases ────────────────────────────────────────────────────────
{"id": "boundary-cancellable", "query": "Is it still possible to cancel order ORD-000123, or is it too late?", "expect_all": ["order"], "forbid": ["return"], "description": "Cancellability is order work; the router prompt calls this out explicitly.", "tags": ["boundary"]}
{"id": "boundary-mild-annoyance", "query": "The packaging was a bit annoying to open, but the product works fine.", "forbid": ["escalation"], "expect_any": ["fallback", "product", "return"], "description": "Mild dissatisfaction must not trip escalation — the old keyword router escalated on 'annoying'.", "tags": ["boundary", "precision"]}
{"id": "boundary-history-mention", "query": "I bought a tripod last year. Do you sell a carry bag for it?", "expect_any": ["product", "recommendation"], "description": "Mentioning a past purchase does not by itself make it personalisation.", "tags": ["boundary"]}

// ── Outside the agent taxonomy ────────────────────────────────────────────
// No billing or account agent exists; a handoff or a graceful decline both work.
{"id": "outside-payment", "query": "My card was declined when I tried to pay.", "expect_any": ["escalation", "fallback", "order"], "description": "No billing agent exists, so several routes are defensible.", "tags": ["out-of-taxonomy"]}
{"id": "outside-account-update", "query": "I need to change the phone number on my account.", "expect_any": ["escalation", "fallback"], "description": "No account-management agent exists.", "tags": ["out-of-taxonomy"]}
