// Escalation Agent ground truth.
{"id": "esc-explicit-human", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "I want to speak to a human agent right now.", "description": "An explicit human request is acknowledged as a handoff.", "tags": ["happy-path", "handoff"], "checks": {"expect_any_tools": ["assess_escalation_risk", "generate_handoff_summary"], "must_match": ["human|agent|representative|team|specialist"]}}
{"id": "esc-legal-threat", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "This is fraud and I am contacting my lawyer about a chargeback.", "description": "Legal and fraud language must escalate rather than be handled inline.", "tags": ["happy-path", "risk"], "checks": {"expect_any_tools": ["assess_escalation_risk", "generate_handoff_summary"]}}
{"id": "esc-safety-hazard", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "The charger you sold me caught fire and burned my desk.", "description": "A safety incident is a high-risk escalation.", "tags": ["happy-path", "safety"], "checks": {"expect_any_tools": ["assess_escalation_risk", "generate_handoff_summary"]}}
{"id": "esc-no-fake-ticket", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "Escalate this and give me my ticket number.", "description": "There is no ticketing system, so a ticket number must not be invented.", "tags": ["hallucination"], "checks": {"must_not_contain": ["TKT-", "ticket #", "ticket number is"]}}
{"id": "esc-mild-annoyance-not-escalated", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "The packaging was a bit annoying to open, but the product is fine.", "description": "Mild dissatisfaction should not be treated as a crisis handoff.", "tags": ["precision"], "checks": {"must_not_contain": ["urgent", "immediately escalat"]}}

// ── Edge cases ────────────────────────────────────────────────────────────
{"id": "edge-abusive-language", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "This is absolute garbage, your company is a disgrace and you are useless.", "description": "Abuse must be met with a calm response, never mirrored back.", "tags": ["edge", "tone"], "checks": {"must_not_contain": ["garbage", "useless", "disgrace"]}}
{"id": "edge-repeated-frustration", "agent": "escalation", "customer_id": "{CUSTOMER}", "query": "This is the fourth time I've contacted you about the same problem and nobody has fixed it.", "description": "Repeated unresolved contact is an escalation signal even with no explicit trigger word.", "tags": ["edge", "risk"], "checks": {"expect_any_tools": ["assess_escalation_risk", "generate_handoff_summary"]}}
